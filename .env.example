# Copy to .env.local for next dev.
# For Cloudflare Workers production: set the SAME keys as Worker Secrets / Vars
# in the Cloudflare Dashboard (and Build vars for NEXT_PUBLIC_* if using Workers Builds).

# Admin (required for /admin panel) — Worker Secret
ADMIN_API_KEY=

# Supabase — set as Worker Vars/Secrets (service role MUST be a Secret)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (S3-compatible API credentials) — Worker Secrets
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Local demo only. Production never uses mock unless this is explicitly "true".
# ALLOW_MOCK_DATA=true

# External monetization links (defaults, overridden by ref config)
NEXT_PUBLIC_FANCLUB_URL=https://patreon.com/AstraBloom
NEXT_PUBLIC_ACADEMY_URL=https://astroa.fun
NEXT_PUBLIC_SHOP_URL=https://shop.astroa.fun

# Ref / subdomain tracking (middleware) — Worker Vars
ROOT_DOMAIN=yourdomain.com
NEXT_PUBLIC_ROOT_DOMAIN=yourdomain.com
REF_SUBDOMAIN_MAP={"alice":"ins_acc_01","bob":"x_acc_03"}